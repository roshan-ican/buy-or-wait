      "seed": 1007943600,
      "version": 1669,
      "versionNonce": 407708592,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789227044107,
      "created": 1789225375980,
      "link": null,
      "locked": false,
      "text": "- in future plans current expenses and \ncurrent spending should be included\n\n- Comparing payment plan, pay in full, \nparitially, 3 months, 6 months wait and \npay later, so that app can decide a\nsafest option for the user\nyou are safe (reason) e.g you have \nsavings, \n\n- app should say wait\n(reason eg if you reduce you optional \nspending\nyou can safely get it \nthe earlist safe data is 10 oct \n)\n\n- categorize the item into\nyou want or you need\n\n- the app says:\n-- you can afford this if you reduce\n    from your shopping or travel for\n    next 2 months\n\n- what if features\n-- what if my salary increases ?\n-- what if i chose 6 months plan ?\n-- what if i reduce my spending ?\n-- what if price drops due to offer\nby 15% ?\n\n \n\n\n\n\n \n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- in future plans current expenses and \ncurrent spending should be included\n\n- Comparing payment plan, pay in full, \nparitially, 3 months, 6 months wait and \npay later, so that app can decide a\nsafest option for the user\nyou are safe (reason) e.g you have \nsavings, \n\n- app should say wait\n(reason eg if you reduce you optional \nspending\nyou can safely get it \nthe earlist safe data is 10 oct \n)\n\n- categorize the item into\nyou want or you need\n\n- the app says:\n-- you can afford this if you reduce\n    from your shopping or travel for\n    next 2 months\n\n- what if features\n-- what if my salary increases ?\n-- what if i chose 6 months plan ?\n-- what if i reduce my spending ?\n-- what if price drops due to offer\nby 15% ?\n\n \n\n\n\n\n \n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
