      "type": "text",
      "x": 2619.4070312977647,
      "y": 684.3059254320605,
      "width": 387.01971435546875,
      "height": 975,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
